/// Un registro por mes. indice = meses corridos desde enero del primer año; sirve para correr períodos y comparar con el año anterior.
table Calendario

	column mes
		dataType: string
		summarizeBy: none
		sourceColumn: mes

		annotation SummarizationSetBy = Automatic

	column anio
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: anio

		annotation SummarizationSetBy = Automatic

	column mes_num
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: mes_num

		annotation SummarizationSetBy = Automatic

	column Fecha
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: Fecha

		annotation SummarizationSetBy = Automatic

	column indice
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: indice

		annotation SummarizationSetBy = Automatic

	column 'Nombre mes'
		dataType: string
		summarizeBy: none
		sourceColumn: Nombre mes
		sortByColumn: mes_num

		annotation SummarizationSetBy = Automatic

	column 'Mes año'
		dataType: string
		summarizeBy: none
		sourceColumn: Mes año
		sortByColumn: indice

		annotation SummarizationSetBy = Automatic

	partition Calendario = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "dim_fecha.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"mes", type text}, {"anio", Int64.Type}, {"mes_num", Int64.Type}}, "en-US"),
				    MinAnio = List.Min(Tipos[anio]),
				    Nombres = {"ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"},
				    ConFecha = Table.AddColumn(Tipos, "Fecha", each #date([anio], [mes_num], 1), type date),
				    ConIndice = Table.AddColumn(ConFecha, "indice", each ([anio] - MinAnio) * 12 + [mes_num], Int64.Type),
				    ConMes = Table.AddColumn(ConIndice, "Nombre mes", each Nombres{[mes_num] - 1}, type text),
				    Final = Table.AddColumn(ConMes, "Mes año", each Nombres{[mes_num] - 1} & "-" & Text.End(Text.From([anio]), 2), type text)
				in
				    Final

	annotation PBI_ResultType = Table

