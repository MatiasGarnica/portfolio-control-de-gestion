/// Drivers por cartera y mes: deuda asignada, % de recupero (E), fee (P), tipo de cambio (FX), posiciones y volumen de canales.
table Drivers

	column esc
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: esc

		annotation SummarizationSetBy = Automatic

	column mes
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: mes

		annotation SummarizationSetBy = Automatic

	column cartera
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: cartera

		annotation SummarizationSetBy = Automatic

	column U
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: U

		annotation SummarizationSetBy = Automatic

	column I
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: I

		annotation SummarizationSetBy = Automatic

	column E
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: E

		annotation SummarizationSetBy = Automatic

	column P
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: P

		annotation SummarizationSetBy = Automatic

	column FX
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: FX

		annotation SummarizationSetBy = Automatic

	column ops
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: ops

		annotation SummarizationSetBy = Automatic

	column pext
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: pext

		annotation SummarizationSetBy = Automatic

	column minutos
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: minutos

		annotation SummarizationSetBy = Automatic

	column sms
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: sms

		annotation SummarizationSetBy = Automatic

	column mails
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: mails

		annotation SummarizationSetBy = Automatic

	column pagos
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: pagos

		annotation SummarizationSetBy = Automatic

	column informes
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: informes

		annotation SummarizationSetBy = Automatic

	column wa
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: wa

		annotation SummarizationSetBy = Automatic

	column deuda
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: deuda

		annotation SummarizationSetBy = Automatic

	column ingreso
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: ingreso

		annotation SummarizationSetBy = Automatic

	partition Drivers = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "fact_drivers_cartera.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"esc", type text}, {"mes", type text}, {"cartera", type text}, {"U", type number}, {"I", type number}, {"E", type number}, {"P", type number}, {"FX", type number}, {"ops", type number}, {"pext", type number}, {"minutos", type number}, {"sms", type number}, {"mails", type number}, {"pagos", type number}, {"informes", type number}, {"wa", type number}, {"deuda", type number}, {"ingreso", type number}}, "en-US"),
				    Final = Tipos
				in
				    Final

	annotation PBI_ResultType = Table

