/// Real, Presupuesto y Forecast.
table Escenario

	column esc
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: esc

		annotation SummarizationSetBy = Automatic

	column Escenario
		dataType: string
		summarizeBy: none
		sourceColumn: Escenario
		sortByColumn: Orden

		annotation SummarizationSetBy = Automatic

	column Orden
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Orden

		annotation SummarizationSetBy = Automatic

	partition Escenario = m
		mode: import
		source =
				let
				    Final = #table(type table [esc = text, Escenario = text, Orden = Int64.Type], {{"REAL", "Real", 1}, {"PPTO", "Presupuesto", 2}, {"FCST", "Forecast", 3}})
				in
				    Final

	annotation PBI_ResultType = Table

