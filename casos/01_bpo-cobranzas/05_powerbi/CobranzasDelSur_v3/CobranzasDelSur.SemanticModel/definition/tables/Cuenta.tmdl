/// Plan de cuentas de gestión en tres niveles: rubro (N1), subrubro (N2) e ítem. n1_orden define el estado de resultados: 1 ingresos, 2 costos de explotación, 3 impuestos directos, 4 estructura, 5 no operacional, 6 ganancias.
table Cuenta

	column item_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: item_id

		annotation SummarizationSetBy = Automatic

	column item
		dataType: string
		summarizeBy: none
		sourceColumn: item
		sortByColumn: item_id

		annotation SummarizationSetBy = Automatic

	column n2
		dataType: string
		summarizeBy: none
		sourceColumn: n2
		sortByColumn: n2_orden

		annotation SummarizationSetBy = Automatic

	column n1
		dataType: string
		summarizeBy: none
		sourceColumn: n1

		annotation SummarizationSetBy = Automatic

	column tipo
		dataType: string
		summarizeBy: none
		sourceColumn: tipo

		annotation SummarizationSetBy = Automatic

	column driver
		dataType: string
		summarizeBy: none
		sourceColumn: driver

		annotation SummarizationSetBy = Automatic

	column n2_orden
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: n2_orden

		annotation SummarizationSetBy = Automatic

	column n1_orden
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: n1_orden

		annotation SummarizationSetBy = Automatic

	column Rubro
		dataType: string
		summarizeBy: none
		sourceColumn: Rubro
		sortByColumn: n1_orden

		annotation SummarizationSetBy = Automatic

	column Subrubro
		dataType: string
		summarizeBy: none
		sourceColumn: Subrubro
		sortByColumn: n2_orden

		annotation SummarizationSetBy = Automatic

	column 'Rubro corto'
		dataType: string
		summarizeBy: none
		sourceColumn: Rubro corto
		sortByColumn: n1_orden

		annotation SummarizationSetBy = Automatic

	partition Cuenta = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "dim_cuenta.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"item_id", Int64.Type}, {"item", type text}, {"n2", type text}, {"n1", type text}, {"tipo", type text}, {"driver", type text}}, "en-US"),
				    Codigo = Table.AddColumn(Tipos, "n2_orden", each let c = Text.BeforeDelimiter([n2], " ") in Number.From(Text.BeforeDelimiter(c, ".")) * 100 + Number.From(Text.AfterDelimiter(c, ".")), Int64.Type),
				    Orden1 = Table.AddColumn(Codigo, "n1_orden", each Number.From(Text.BeforeDelimiter([n1], " ")), Int64.Type),
				    Rubro = Table.AddColumn(Orden1, "Rubro", each Text.AfterDelimiter([n1], " "), type text),
				    Subrubro = Table.AddColumn(Rubro, "Subrubro", each Text.AfterDelimiter([n2], " "), type text),
				    Cortos = {"Ingresos", "Costos de explotación", "Impuestos directos", "Estructura", "No operacional", "Ganancias"},
				    Final = Table.AddColumn(Subrubro, "Rubro corto", each Cortos{[n1_orden] - 1}, type text)
				in
				    Final

	annotation PBI_ResultType = Table

