/// Mes solo o acumulado del año hasta el mes elegido. Sin relación.
table Vista

	column Vista
		dataType: string
		summarizeBy: none
		sourceColumn: Vista
		sortByColumn: Orden

		annotation SummarizationSetBy = Automatic

	column Orden
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Orden

		annotation SummarizationSetBy = Automatic

	partition Vista = m
		mode: import
		source =
				let
				    Final = #table(type table [Vista = text, Orden = Int64.Type], {{"Mes", 1}, {"Acumulado", 2}})
				in
				    Final

	annotation PBI_ResultType = Table

