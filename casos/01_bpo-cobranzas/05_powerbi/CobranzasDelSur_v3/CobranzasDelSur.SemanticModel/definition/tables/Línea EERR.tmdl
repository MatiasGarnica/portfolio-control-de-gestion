/// Renglones del estado de resultados ejecutivo (rubros, subtotales y márgenes). Sin relación: cada renglón suma los rubros n1_orden entre Desde y Hasta.
table 'Línea EERR'

	column Orden
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Orden

		annotation SummarizationSetBy = Automatic

	column 'Línea'
		dataType: string
		summarizeBy: none
		sourceColumn: Línea
		sortByColumn: Orden

		annotation SummarizationSetBy = Automatic

	column Tipo
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Tipo

		annotation SummarizationSetBy = Automatic

	column Desde
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Desde

		annotation SummarizationSetBy = Automatic

	column Hasta
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Hasta

		annotation SummarizationSetBy = Automatic

	partition 'Línea EERR' = m
		mode: import
		source =
				let
				    Final = #table(type table [Orden = Int64.Type, Línea = text, Tipo = text, Desde = Int64.Type, Hasta = Int64.Type], {
				        {1, "Ingresos operativos", "rubro", 1, 1},
				        {2, "Costos de explotación", "rubro", 2, 2},
				        {3, "Impuestos directos", "rubro", 3, 3},
				        {4, "MARGEN BRUTO", "sub", 1, 3},
				        {5, "% margen bruto", "pct", 1, 3},
				        {6, "Gastos de estructura", "rubro", 4, 4},
				        {7, "MARGEN OPERATIVO", "sub", 1, 4},
				        {8, "% margen operativo", "pct", 1, 4},
				        {9, "Resultado no operacional", "rubro", 5, 5},
				        {10, "RESULTADO ANTES DE IMPUESTOS", "sub", 1, 5},
				        {11, "Impuesto a las ganancias", "rubro", 6, 6},
				        {12, "UTILIDAD NETA", "sub", 1, 6},
				        {13, "% margen neto", "pct", 1, 6}})
				in
				    Final

	annotation PBI_ResultType = Table

