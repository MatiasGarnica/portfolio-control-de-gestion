/// Carteras de clientes. EST agrupa los gastos de estructura que no son de ninguna cartera.
table Cartera

	column code
		dataType: string
		summarizeBy: none
		sourceColumn: code

		annotation SummarizationSetBy = Automatic

	column nombre
		dataType: string
		summarizeBy: none
		sourceColumn: nombre

		annotation SummarizationSetBy = Automatic

	column industria
		dataType: string
		summarizeBy: none
		sourceColumn: industria

		annotation SummarizationSetBy = Automatic

	column negocio
		dataType: string
		summarizeBy: none
		sourceColumn: negocio

		annotation SummarizationSetBy = Automatic

	column moneda
		dataType: string
		summarizeBy: none
		sourceColumn: moneda

		annotation SummarizationSetBy = Automatic

	column Cartera
		dataType: string
		summarizeBy: none
		sourceColumn: Cartera

		annotation SummarizationSetBy = Automatic

	column 'Nombre corto'
		dataType: string
		summarizeBy: none
		sourceColumn: Nombre corto

		annotation SummarizationSetBy = Automatic

	partition Cartera = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "dim_cartera.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"code", type text}, {"nombre", type text}, {"industria", type text}, {"negocio", type text}, {"moneda", type text}}, "en-US"),
				    ConEstructura = Table.InsertRows(Tipos, Table.RowCount(Tipos), {[code = "EST", nombre = "Estructura", industria = "Estructura", negocio = "Estructura", moneda = "ARS"]}),
				    ConCartera = Table.AddColumn(ConEstructura, "Cartera", each [code] & " · " & [nombre], type text),
				    Final = Table.AddColumn(ConCartera, "Nombre corto", each Text.BeforeDelimiter([nombre], " · "), type text)
				in
				    Final

	annotation PBI_ResultType = Table

